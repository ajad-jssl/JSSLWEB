<style>
                 body {
                    margin:0;
                     font-family: 'Segoe UI', Arial, sans-serif;
                    background: radial-gradient(circle,rgba(255, 255, 255, 1) 0%, rgba(199, 223, 242, 1) 50%);
                      height:100vh;
                      display:flex;
                      justify-content:center;
                      align-items:center;
                     color:#333;
                    }
                   .container {
                      background:#fff;
                      padding:40px;
                      border-radius:12px;
                      text-align:center;
                      box-shadow:0 10px 30px rgba(0,0,0,0.2);
                      max-width:400px;
                      width:90%;
                    }
                    .code {
                     font-size:80px;
                      font-weight:bold;
                      color:#764ba2;
                      margin-bottom:10px;
                    }
                    .title {
                      font-size:22px;
                      margin-bottom:10px;
                    }
                    .message {
                      font-size:14px;
                      color:#666;
                      margin-bottom:20px;
                    }
                    .btn {
                      display:inline-block;
                      padding:10px 20px;
                      background:#667eea;
                      color:#fff;
                      text-decoration:none;
                     border-radius:6px;
                      transition:0.3s;
                   }
                    .btn:hover {
                      background:#5a67d8;
                    }
                 </style>
</head>

