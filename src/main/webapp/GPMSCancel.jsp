<script>
$('#packingNote').on('change', function() {
    const file = this.files[0];
    if (file) {
        const fileType = file.type;
        if (fileType !== 'application/pdf') {
            alert('Please select a PDF file.');
            $(this).val('');  // Clear the input
        }
    }
});
</script>
